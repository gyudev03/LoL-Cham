# Riot Developer Portal에서 발급한 Personal API Key를 입력하세요.
# 절대로 VITE_ 접두사를 붙이거나 Git에 커밋하지 마세요.
RIOT_API_KEY=RGAPI-your-key-here
PORT=8787
# Render 등 배포 환경에서는 영속 디스크의 절대 경로를 지정합니다.
# DATA_DIR=/var/data
# 웹 접근 보호용 Basic Auth입니다. 배포 시 반드시 설정하세요.
# APP_USERNAME=chamlog
# APP_PASSWORD=길고_고유한_비밀번호
# 이번 시즌 분석 시작일(KR 기준). 비워두면 해당 연도의 1월 8일 12:00(KR)을 사용합니다.
# SEASON_START=2026-01-08
